# Environment

Copy to `.env` for local overrides (never commit secrets).

# PLATFORM_ENV=development
# PLATFORM_DB_PATH=.platform/registry.db
# PLATFORM_DATABASE_URL=postgresql://user:pass@localhost:5432/ai_platform
# PLATFORM_SECRETS_KEY=change-me
# PLATFORM_AUTH_REQUIRED=true
# PLATFORM_AUTH_SECRET=change-me-jwt-secret
# PLATFORM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PLATFORM_ALLOW_DEV_LOGIN=true
#
# Production posture (API refuses to boot if these are weak / missing):
# PLATFORM_ENV=production
# PLATFORM_SECRETS_KEY=<strong-random-32+>
# PLATFORM_AUTH_SECRET=<strong-random-32+>
# PLATFORM_ALLOW_DEV_LOGIN=false
# PLATFORM_REDIS_URL=redis://redis:6379/0
# PLATFORM_GOVERNOR_BACKEND=auto
# PLATFORM_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# PLATFORM_OIDC_CLIENT_ID=
#
# Multi-instance tool governor (shared counters across API replicas):
# PLATFORM_REDIS_URL=redis://localhost:6379/0
# PLATFORM_GOVERNOR_BACKEND=auto   # auto | memory | redis
#
# Real OIDC (Okta / Azure AD / Keycloak) — when set, Studio shows IdP sign-in:
# PLATFORM_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# PLATFORM_OIDC_CLIENT_ID=
# PLATFORM_OIDC_CLIENT_SECRET=
# PLATFORM_OIDC_REDIRECT_URI=http://localhost:5173/
# PLATFORM_OIDC_SCOPES=openid profile email
# PLATFORM_OIDC_AUDIENCE=
# OpenTelemetry OTLP/HTTP (Jaeger / Grafana / Datadog collector):
# PLATFORM_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# PLATFORM_OTLP_SERVICE_NAME=ai-platform-api
# PLATFORM_OTLP_CONSOLE=false
# OPENAI_API_KEY=
