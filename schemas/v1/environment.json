{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/environment.json",
  "title": "Environment",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "Environment" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "properties": {
        "promotionFrom": { "type": "string" },
        "requireApproval": { "type": "boolean" },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "bundlePolicy": { "type": "string" }
      }
    }
  }
}
