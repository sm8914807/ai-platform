{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/prompt.json",
  "title": "Prompt",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "Prompt" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "required": ["template"],
      "properties": {
        "template": { "type": "string" },
        "variables": { "type": "object" },
        "experiments": { "type": "array" }
      }
    }
  }
}
