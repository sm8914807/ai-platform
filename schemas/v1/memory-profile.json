{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/memory-profile.json",
  "title": "MemoryProfile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "MemoryProfile" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "backend"],
            "properties": {
              "type": { "enum": ["conversation", "semantic", "entity", "session", "episodic"] },
              "backend": { "type": "string" },
              "ttl": { "type": "string" },
              "maxTokens": { "type": "integer" },
              "retention": { "type": "string" }
            }
          }
        },
        "summarization": { "type": "object" },
        "versioning": { "type": "boolean" }
      }
    }
  }
}
