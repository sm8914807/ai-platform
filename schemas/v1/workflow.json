{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/workflow.json",
  "title": "Workflow",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "trigger": { "type": "object" },
        "steps": { "type": "array" }
      }
    }
  }
}
