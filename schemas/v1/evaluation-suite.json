{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/evaluation-suite.json",
  "title": "EvaluationSuite",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "EvaluationSuite" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "properties": {
        "dataset": { "type": "array" },
        "evaluators": { "type": "array" },
        "triggers": { "type": "array" },
        "gates": { "type": "object" }
      }
    }
  }
}
