{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai/schemas/v1/agent.json",
  "title": "Agent",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.ai/v1" },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "metadata.json" },
    "spec": {
      "type": "object",
      "required": ["role", "modelRef", "promptRef"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["executor", "planner", "supervisor", "reviewer", "reflector", "router"]
        },
        "modelRef": { "type": "string" },
        "promptRef": { "type": "string" },
        "toolboxRef": { "type": "string" },
        "memoryRef": { "type": "string" },
        "knowledgeRefs": { "type": "array", "items": { "type": "string" } },
        "guardrails": { "type": "array", "items": { "type": "string" } },
        "supervisorRef": { "type": "string" },
        "policies": { "type": "array", "items": { "type": "string" } },
        "delegation": { "type": "object" },
        "collaboration": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "maxIterations": { "type": "integer", "minimum": 1 },
            "sharedContext": { "type": "boolean" },
            "contextScope": { "enum": ["session", "task", "org"] }
          }
        },
        "reflection": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "criticRef": { "type": "string" },
            "maxRetries": { "type": "integer" },
            "rubricRef": { "type": "string" }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "published": { "type": "boolean" },
        "bundleHash": { "type": "string" }
      }
    }
  }
}
